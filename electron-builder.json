{
  "appId": "app.canvasweekly.desktop",
  "productName": "Canvas Weekly",
  "directories": { "output": "dist" },
  "files": ["src/**/*", "package.json"],
  "asar": true,
  "asarUnpack": ["node_modules/@openai/codex-win32-*/**/*"],
  "extraResources": [{ "from": "build/branding", "to": "icons", "filter": ["icon.ico", "icon-dark.ico"] }],
  "npmRebuild": false,
  "electronDist": "node_modules/electron/dist",
  "win": {
    "icon": "build/branding/icon.ico",
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "signExecutable": false,
    "requestedExecutionLevel": "asInvoker",
    "artifactName": "Canvas-Weekly-${version}-${arch}-Setup.${ext}"
  },
  "nsis": {
    "include": "build/installer.nsh",
    "installerIcon": "build/branding/icon.ico",
    "uninstallerIcon": "build/branding/icon.ico",
    "installerSidebar": "build/branding/installer-sidebar.bmp",
    "uninstallerSidebar": "build/branding/installer-sidebar.bmp",
    "installerHeader": "build/branding/installer-header.bmp",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": false,
    "deleteAppDataOnUninstall": false
  }
}
